# Copy to .env (git-ignored) and fill in. Only tokens/fetch-figma-tokens.mjs needs this.
# Create at: Figma → Settings → Security → Personal access tokens (scope: File content = read).
FIGMA_TOKEN=<paste-your-figma-personal-access-token-here>

# Optional: override the admin app / credentials the token spec logs in with.
# URRY_ADMIN_BASE=https://dev-portal.urry.com
# URRY_ADMIN_EMAIL=demo@urry.com
# URRY_ADMIN_PASSWORD=...
