{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Task",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "LS",
      "ToolSearch",
      "WebFetch",
      "mcp__playwright-test",
      "mcp__playwright-test__*",
      "mcp__playwright-test__browser_evaluate",
      "mcp__playwright-test__browser_run_code_unsafe",
      "mcp__playwright-test__browser_click",
      "mcp__playwright-test__browser_navigate",
      "mcp__playwright-test__browser_type",
      "mcp__playwright-test__browser_snapshot",
      "mcp__playwright-test__generator_setup_page",
      "mcp__claude_ai_Asana",
      "mcp__claude_ai_Asana__*",
      "mcp__claude_ai_Atlassian_Rovo",
      "mcp__claude_ai_Atlassian_Rovo__*",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePage",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePageFooterComments",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePageInlineComments",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__search",
      "mcp__claude_ai_Atlassian_Rovo__fetch",
      "Bash(npx playwright:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
